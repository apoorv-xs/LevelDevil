{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/sales",
      "destination": "/sales.html"
    },
    {
      "source": "/sales/:match*",
      "destination": "/sales.html"
    },
    {
      "source": "/contact",
      "destination": "/sales.html"
    },
    {
      "source": "/contact/:match*",
      "destination": "/sales.html"
    },
    {
      "source": "/dossier",
      "destination": "/sales.html"
    },
    {
      "source": "/dossier/:match*",
      "destination": "/sales.html"
    },
    {
      "source": "/audit",
      "destination": "/sales.html"
    },
    {
      "source": "/audit/:match*",
      "destination": "/sales.html"
    },
    {
      "source": "/workspace",
      "destination": "/workspace/index.html"
    },
    {
      "source": "/workspace/",
      "destination": "/workspace/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(sales|shell|dossier|audit)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sales-app\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/workspace/(prospects_data|custom_prospects)\\.(js|json)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, private, max-age=0"
        }
      ]
    },
    {
      "source": "/workspace/:match*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://cdn.tailwindcss.com https://apis.google.com https://accounts.google.com https://ssl.gstatic.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://ui-avatars.com https://*.googleusercontent.com https://*.google.com https://ssl.gstatic.com https://api.qrserver.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebasedatabase.app https://www.gstatic.com https://accounts.google.com https://*.google.com https://*.googleusercontent.com https://discord.com https://cloudflareinsights.com; frame-src 'self' https://apis.google.com https://*.firebaseapp.com https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
